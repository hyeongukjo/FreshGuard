<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_bottom_sheet"> <TextView
    android:id="@+id/tv_scan_result_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="인식 결과"
    android:textSize="20sp"
    android:textStyle="bold"
    android:textColor="#000000"
    android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tv_scanned_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="인식된 유통기한: 2026.05.01"
        android:textColor="#3F51B5"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/et_food_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="식품명을 입력하세요 (예: 우유)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_quantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="수량을 입력하세요 (예: 1개, 500g)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보관 위치"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rg_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <RadioButton
            android:id="@+id/rb_fridge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="냉장실"
            android:checked="true" /> <RadioButton
        android:id="@+id/rb_freezer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="냉동실"
        android:layout_marginStart="16dp" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_save_ingredient"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="저장하기"
        android:textSize="18sp"
        android:backgroundTint="#5C7CFA"
        android:textColor="#FFFFFF" />

</LinearLayout>